{
  "name": "api.oluwasetemi.dev",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "author": {
    "name": "Oluwasetemi Ojo",
    "email": "me@oluwasetemi.dev",
    "url": "https://oluwasetemi.dev"
  },
  "license": "MIT",
  "homepage": "https://api.oluwasetemi.dev/reference",
  "repository": {
    "type": "git",
    "url": "https://github.com/oluwasetemi/api.oluwasetemi.dev"
  },
  "engines": {
    "node": ">=22.15.32"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "cross-env NODE_ENV=test vitest",
    "test:watch": "cross-env NODE_ENV=test vitest --watch",
    "test:coverage": "cross-env NODE_ENV=test vitest --coverage --run --silent",
    "build": "tsc && tsc-alias",
    "seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "simple-git-hooks",
    "api-docs": "pnpm dlx open-cli http://localhost:4444/reference",
    "better-auth-docs": "pnpm dlx open-cli http://localhost:4444/api/auth/docs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/schema": "^10.1.1",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "dotenv-expand": "^1000.0.0",
    "drizzle-graphql": "^0.8.5",
    "drizzle-orm": "0.45.3",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "hono": "^4.13.9",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.4",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "stoker": "2.0.1",
    "ws": "^8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.6",
    "@setemiojo/eslint-config": "^9.5.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "bash -c 'pnpm typecheck'"
    ]
  }
}
